# =========================
# AI Sysadmin Agent - .gitignore
# =========================

# ----- Distribution Artifacts -----
dist/
backend/dist/
*.tar.gz
ai-sysadmin-release.tar.gz
distribution_site/

# ----- PyInstaller -----
backend/build/
backend/*.spec

# ----- Environment Files -----
.env
.env.local
*.env
!.env.prod.template
!.env.example

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/

# ----- Node.js -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Next.js -----
.next/
out/
frontend/.next/
frontend/out/

# ----- Tauri / Rust -----
frontend/src-tauri/target/
frontend/src-tauri/Cargo.lock


# ----- Generated Files -----
backend/reports/
*_sorted.json

# ----- Database -----
postgres_data/

# ----- Logs -----
*.log

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- OS -----
.DS_Store
Thumbs.db

# ----- SSL Certificates -----
nginx/ssl/*.crt
nginx/ssl/*.key
!nginx/ssl/.gitkeep

# ----- Temporary Files -----
*.tmp
*.bak
diff_output.txt
downloaded_versions.html
agent_website.html
