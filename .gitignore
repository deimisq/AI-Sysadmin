# =========================
# AI Sysadmin Agent - .gitignore
# =========================

# ----- Distribution Artifacts -----
dist/
backend/dist/
*.tar.gz
ai-sysadmin-release.tar.gz
distribution_site/

# ----- PyInstaller -----
backend/build/
backend/*.spec

# ----- Environment Files -----
.env
.env.local
.env.*
*.env
!.env.prod.template
!.env.example

# ----- Python -----
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
*.tsbuildinfo
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/

# ----- Node.js & Vite -----
**/node_modules/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Next.js -----
**/.next/
**/out/

# ----- Tauri / Rust -----
**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/Cargo.lock

# ----- Visual Studio -----
**/.vs/
**/[Bb]in/
**/[Oo]bj/
**/*.user
**/*.suo
**/*.userosscache
**/*.sln.docstates


# ----- Generated Files -----
backend/reports/
*_sorted.json

# ----- Database -----
postgres_data/

# ----- Logs -----
*.log

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- OS -----
.DS_Store
Thumbs.db

# ----- SSL Certificates -----
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/certs/*.key
nginx/certs/*.crt
!nginx/ssl/.gitkeep

# ----- Temporary Files -----
*.tmp
*.bak
diff_output.txt
.preview-tools/
downloaded_versions.html
agent_website.html
