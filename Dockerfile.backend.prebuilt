# Backend using pre-compiled binary
FROM gcr.io/distroless/cc-debian12

WORKDIR /app

# Copy compiled binary from local filesystem
COPY backend/dist/sysadmin-agent-backend /app/backend

# Copy VERSION.json
COPY VERSION.json /app/

# Expose port
EXPOSE 8000

# Run the binary
ENTRYPOINT ["/app/backend"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
