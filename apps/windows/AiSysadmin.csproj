<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Version>0.10.0-preview.24</Version>
    <AssemblyVersion>0.10.0.24</AssemblyVersion>
    <FileVersion>0.10.0.24</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- Necesario para ActiveX RDP -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>AI Sysadmin Agent</Product>
    <Title>AI Sysadmin Agent</Title>
    <RootNamespace>AiSysadminDesktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- El navegador embebido -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\frontend-desktop-ui\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 
  <ItemGroup>
     Referencia COM eliminada temporalmente.
  </ItemGroup> 
  -->

</Project>
