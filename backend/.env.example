# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/dbname

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Encryption Configuration
# IMPORTANT: Change this in production! This key is used to encrypt/decrypt sensitive data
# Generate a strong random key for production use
ENCRYPTION_KEY=change-this-to-a-strong-random-key-in-production

# Frontend URL (for email links)
FRONTEND_URL=https://testing.sentrait.com.uy
