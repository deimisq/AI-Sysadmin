[Unit]
Description=AI Sysadmin Agent License Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/agent
Environment=PATH=/var/www/agent/license_venv/bin
ExecStart=/var/www/agent/license_venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 license_server:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
