{
    "$schema": "https://schema.tauri.app/config/2.0",
    "productName": "AI Sysadmin Agent",
    "version": "2.0.0",
    "identifier": "com.aisysadmin.agent",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "AI Sysadmin Agent",
                "width": 1400,
                "height": 900,
                "resizable": true,
                "fullscreen": false,
                "minWidth": 1024,
                "minHeight": 768
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png"
        ],
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        },
        "linux": {
            "deb": {
                "depends": []
            }
        }
    }
}