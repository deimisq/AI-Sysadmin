{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI Sysadmin Agent",
  "version": "0.9.4",
  "identifier": "com.aisysadmin.agent",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run export"
  },
  "app": {
    "windows": [
      {
        "title": "AI Sysadmin Agent",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": [
          "en-US",
          "es-ES"
        ]
      }
    }
  }
}