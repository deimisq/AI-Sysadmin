{
    "name": "ai-agent-root",
    "private": true,
    "scripts": {
        "web:dev": "npm --prefix frontend-web run dev",
        "web:build": "npm --prefix frontend-web run build",
        "desktop:dev": "npm --prefix frontend-desktop-ui run dev",
        "desktop:build": "npm --prefix frontend-desktop-ui run build",
        "windows:dev": "dotnet run --project apps/windows/AiSysadmin.csproj",
        "windows:build": "npm run desktop:build && dotnet build apps/windows/AiSysadmin.csproj -c Release",
        "windows:package": "powershell -NoProfile -File scripts/package-windows.ps1"
    }
}
